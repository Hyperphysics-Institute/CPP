# Choose a scaling window by hand for now
t_min, t_max = 10, 200

mask = (t_vals >= t_min) & (t_vals <= t_max)
log_t = np.log(t_vals[mask])
log_P = np.log(P_vals[mask])

coeffs = np.polyfit(log_t, log_P, 1)
slope, intercept = coeffs
d_s = -2 * slope

print(f"Fitted slope m = {slope:.6f}")
print(f"Estimated spectral dimension d_s = {-2*slope:.6f}")

plt.figure(figsize=(5,4))
plt.plot(log_t, log_P, "o", markersize=3, label="data")
plt.plot(log_t, slope*log_t + intercept, "r-", label=f"fit, d_s={d_s:.3f}")
plt.xlabel("log t")
plt.ylabel("log P(t)")
plt.legend()
plt.title(f"Scaling window t ∈ [{t_min}, {t_max}]")
plt.tight_layout()
plt.show()

