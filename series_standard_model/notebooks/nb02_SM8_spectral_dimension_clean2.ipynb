{
  "notebook_metadata": {
    "title": "Spectral Dimension Extraction for SM8 Cage Graph",
    "description": "This notebook loads the GPU‑generated return‑probability CSV and fits P(t) ~ t^{-d_s/2} to extract the spectral dimension d_s."
  },
  "imports": [
    "numpy as np",
    "pandas as pd", 
    "matplotlib.pyplot as plt"
  ],
  "data_loading": {
    "input_file": "nb02_SM8_600cell_2ring_return_prob.csv",
    "data_extraction": {
      "t_vals": "df['t'].values",
      "P_t": "df['P'].values"
    },
    "validation": [
      "print('Loaded', len(t_vals), 'time steps')",
      "print('Columns:', df.columns.tolist())"
    ]
  },
  "visualization": {
    "initial_plot": {
      "plot_type": "loglog",
      "figure_size": [6, 4],
      "data": "t_vals[1:], P_t[1:]",
      "style": "'o-', markersize=3",
      "labels": {
        "xlabel": "t",
        "ylabel": "P(t)",
        "title": "Return probability (log-log)"
      },
      "grid": "True, which='both', ls='--', alpha=0.3"
    }
  },
  "analysis_parameters": {
    "scaling_window": {
      "t_min": 50,
      "t_max": 500,
      "description": "Choose scaling window for fitting"
    },
    "data_filtering": {
      "mask": "(df['t'] >= t_min) & (df['t'] <= t_max)",
      "validation": "print('Number of points in window:', mask.sum())"
    }
  },
  "log_transformation": {
    "x_data": "np.log(df['t'][mask])",
    "y_data": "np.log(df['P'][mask])",
    "range_validation": [
      "print('log(t) range:', x.min(), 'to', x.max())",
      "print('log(P) range:', y.min(), 'to', y.max())"
    ]
  },
  "fitting_procedure": {
    "method": "np.polyfit(x, y, 1)",
    "parameters": {
      "slope": "slope",
      "intercept": "intercept"
    },
    "spectral_dimension_calculation": "d_s = -2 * slope",
    "output": [
      "print(f'Slope m = {slope:.6f}')",
      "print(f'Spectral dimension d_s = {d_s:.6f}')"
    ]
  },
  "results_visualization": {
    "fitted_plot": {
      "figure_size": [6, 4],
      "data_points": {
        "style": "'o', markersize=2",
        "label": "data"
      },
      "fitted_line": {
        "x_range": "np.linspace(np.log(t_min), np.log(t_max), 200)",
        "equation": "y_fit = slope * x_fit + intercept",
        "style": "'r-'",
        "label": "f'fit (d_s={d_s:.3f})'"
      },
      "plot_settings": {
        "xlabel": "t",
        "ylabel": "P(t)",
        "title": "Spectral Dimension Fit",
        "grid": "True, which='both', ls='--', alpha=0.3",
        "legend": true
      }
    }
  },
  "data_output": {
    "output_file": "nb02_SM8_return_prob_data_current_graph_copy.csv",
    "save_method": "df.to_csv(output_path, index=False)",
    "confirmation": "print('Saved CSV to:', output_path)"
  },
  "workflow_summary": {
    "steps": [
      "Load return probability data from CSV",
      "Create initial log-log visualization", 
      "Define scaling window for analysis",
      "Apply logarithmic transformation to data",
      "Perform linear fit to extract slope",
      "Calculate spectral dimension from slope",
      "Visualize fitted results",
      "Save processed data to new CSV file"
    ]
  },
  "mathematical_relationships": {
    "theoretical_model": "P(t) ~ t^{-d_s/2}",
    "log_transformation": "log(P(t)) ~ (-d_s/2) * log(t)",
    "spectral_dimension_extraction": "d_s = -2 * slope"
  }
}
