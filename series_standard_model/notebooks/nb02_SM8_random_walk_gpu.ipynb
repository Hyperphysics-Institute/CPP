{
  "imports": [
    "math",
    "time", 
    "pathlib.Path",
    "numpy as np",
    "pandas as pd", 
    "torch",
    "matplotlib.pyplot as plt"
  ],
  "configuration": {
    "matplotlib_style": "seaborn-v0_8-darkgrid",
    "project_root": "Path(\".\").resolve()",
    "edge_list_path": "PROJECT_ROOT / \"nb02_SM8_600cell_2ring_edgelist.txt\"",
    "output_csv_path": "PROJECT_ROOT / \"nb02_SM8_600cell_2ring_return_prob.csv\""
  },
  "device_setup": {
    "cuda_check": "torch.cuda.is_available()",
    "device_selection": {
      "if_cuda": "torch.device(\"cuda\")",
      "else": "torch.device(\"cpu\")"
    }
  },
  "functions": {
    "load_edge_list": {
      "parameters": ["path: Path"],
      "description": "Load an undirected edge list from a text file. Assumes each line: u v. Vertices are 0-based or 1-based; we normalize to 0-based.",
      "returns": "np.array(edges, dtype=np.int64)",
      "logic": [
        "Initialize empty edges list",
        "Read file line by line", 
        "Skip empty lines and comments starting with #",
        "Split each line into two integers u, v",
        "Append (u, v) to edges list",
        "Return as numpy array"
      ]
    },
    "build_neighbors_csr": {
      "parameters": ["num_vertices: int", "edges: np.ndarray"],
      "description": "Build a compact neighbor representation using CSR format",
      "returns": ["neighbors_flat", "offsets"],
      "logic": [
        "Calculate degree for each vertex",
        "Build offset array with cumulative sums",
        "Create flat neighbors array",
        "Fill neighbors using cursor array",
        "Return neighbors_flat and offsets"
      ]
    },
    "random_walk_return_prob": {
      "parameters": [
        "neighbors_flat_t",
        "offsets_t", 
        "walker_positions",
        "start_vertex: int",
        "max_steps: int",
        "generator: torch.Generator"
      ],
      "description": "Simulate random walks and calculate return probabilities",
      "returns": ["t_vals", "P_vals"],
      "logic": [
        "Initialize probability tracking",
        "For each time step:",
        "  Get neighbor offsets for current positions",
        "  Calculate degrees",
        "  Generate random choices", 
        "  Update walker positions",
        "  Calculate return probability",
        "  Store results and print progress"
      ]
    }
  },
  "simulation_parameters": {
    "num_walkers": 100000,
    "max_steps": 2000,
    "start_vertex": 0,
    "rng_seed": 12345
  },
  "data_processing": {
    "edge_normalization": "Subtract minimum vertex to make 0-based",
    "vertex_count": "int(edges.max()) + 1",
    "neighbor_structure": "CSR format with neighbors_flat and offsets"
  },
  "tensor_operations": {
    "convert_to_tensors": [
      "neighbors_flat_t = torch.from_numpy(neighbors_flat).to(device)",
      "offsets_t = torch.from_numpy(offsets).to(device)",
      "num_vertices_t = torch.tensor(num_vertices, device=device, dtype=torch.long)"
    ],
    "walker_initialization": "torch.full((num_walkers,), fill_value=start_vertex, device=device, dtype=torch.long)",
    "random_generator": "torch.Generator(device=device) with manual_seed(rng_seed)"
  },
  "output": {
    "dataframe_creation": "pd.DataFrame({'t': t_vals, 'P(t)': P_vals})",
    "csv_export": "df.to_csv(OUTPUT_CSV_PATH, index=False)",
    "console_output": [
      "Torch version and CUDA availability",
      "Device information",
      "File paths",
      "Edge and vertex statistics", 
      "Simulation parameters",
      "Progress updates during simulation",
      "Final results summary"
    ]
  }
}
