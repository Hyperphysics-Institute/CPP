# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS / editor artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# LaTeX build artifacts
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
